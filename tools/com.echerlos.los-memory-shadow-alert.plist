<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.echerlos.los-memory-shadow-alert</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>__HOME__/syncfolder/project/los-memory/scripts/shadow_report.py</string>
		<string>alert</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.local/share/los-memory-shadow/alert.err.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.local/share/los-memory-shadow/alert.out.log</string>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>Umask</key>
	<integer>63</integer>
	<key>WorkingDirectory</key>
	<string>__HOME__/syncfolder/project/los-memory</string>
</dict>
</plist>
