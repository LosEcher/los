<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  los daemon — launchd 常驻 gateway+executor(经 tools/los-launchd-wrapper.sh)。
  安装(替换 PROJECT_ROOT 为项目绝对路径):
    sed "s|__LOS_ROOT__|/path/to/los|g" tools/los-launchd.plist \
      > ~/Library/LaunchAgents/com.los.daemon.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.los.daemon.plist
  卸载:
    launchctl bootout gui/$(id -u)/com.los.daemon
  KeepAlive=true:wrapper 本身常驻,意外退出由 launchd 立即拉起;
  wrapper 内部每 30s 检查服务健康,不健康则 los.sh start(幂等)。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.los.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__LOS_ROOT__/tools/los-launchd-wrapper.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- 执行器由独立的 launchd 任务托管（钉树 ~/.local/share/los，见
         tools/deploy-drivers/macos-launchd.sh）。wrapper 据此不再检查 8090、
         也绝不用 los.sh start（那会连执行器一起拉起并与钉树实例抢端口，2026-10-11）。 -->
    <key>LOS_EXECUTOR_EXTERNAL</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOS_ROOT__/.los-runtime/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOS_ROOT__/.los-runtime/launchd.err.log</string>
</dict>
</plist>
