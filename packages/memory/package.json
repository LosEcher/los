{
  "name": "@los/memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./session-event-sink": "./src/core/session-event-sink.ts"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "benchmark:fts": "node --import tsx --import ./src/test-setup.ts --test --test-concurrency 1 src/fts-performance.test.ts",
    "test": "node --import tsx --import ./src/test-setup.ts --test --test-concurrency 1 --experimental-test-coverage '--test-coverage-include=src/**/*.ts' src/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@los/contracts": "workspace:*",
    "@los/infra": "workspace:*",
    "@los/mcp-stdio": "workspace:*"
  },
  "devDependencies": {
    "@los/agent": "workspace:*",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
